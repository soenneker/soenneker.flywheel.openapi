            },
            "description": "Items returned for the requested page."
          },
          "totalCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Total number of matching items before pagination.",
            "format": "int32"
          }
        }
      },
      "ServerView": {
        "required": [
          "id",
          "expiresAt",
          "workers",
          "runningJobs"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "expiresAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          },
          "workers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "runningJobs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobView"
            }
          },
          "workerHistory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerWorkerHistoryPoint"
            },
            "description": "Recent worker counts recorded by server heartbeats, ordered oldest first."
          },
          "observedAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Server-side UTC Unix milliseconds at which this snapshot was read.",
            "format": "int64"
          }
        },
        "description": "A live Flywheel worker server and its currently leased jobs."
      },
      "ServerWorkerHistoryPoint": {
        "required": [
          "timestamp",
          "busyWorkers",
          "expiresAt"
        ],
        "type": "object",
        "properties": {
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Observation time in UTC Unix milliseconds.",
            "format": "int64"
          },
          "busyWorkers": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Number of jobs with a live lease on the server.",
            "format": "int32"
          },
          "expiresAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Time after which this observation is no longer considered live.",
            "format": "int64"
          }
        },
        "description": "A server's busy-worker count observed at a heartbeat."
      },
      "StartedJob": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "description": "Identifier of the execution queued by a manual run action."
      }
    },
    "securitySchemes": {
