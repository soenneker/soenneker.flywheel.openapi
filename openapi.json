{
  "openapi": "3.0.4",
  "info": {
    "title": "Flywheel Dashboard API",
    "description": "Flywheel dashboard HTTP API. Routes use the default /flywheel EnginePath; hosts can configure a different prefix. Obtain a token from /flywheel/csrf before signing in, send it in X-Flywheel-CSRF to /flywheel/login, and retain the cookies. Refresh the CSRF token after signing in and send it in X-Flywheel-CSRF for all POST requests. The SignalR hub is not described by this HTTP specification.",
    "version": "v1"
  },
  "paths": {
    "/flywheel/user": {
      "get": {
        "tags": [
          "Flywheel authentication"
        ],
        "summary": "Returns the authenticated dashboard user.",
        "description": "Returns the username associated with the authenticated dashboard cookie.",
        "operationId": "FlywheelAuthentication_GetUser",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardUser"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/csrf": {
      "get": {
        "tags": [
          "Flywheel authentication"
        ],
        "summary": "Issues an antiforgery token for the current dashboard identity.",
        "description": "Available anonymously. Issues an antiforgery cookie and request token for the current dashboard identity. Use the request token for dashboard POST requests.",
        "operationId": "FlywheelAuthentication_GetCsrf",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Csrf"
                }
              }
            }
          }
        },
        "security": [ ]
      }
    },
    "/flywheel/login": {
      "post": {
        "tags": [
          "Flywheel authentication"
        ],
        "summary": "Verifies credentials and issues the secure dashboard cookie.",
        "description": "Accepts dashboard credentials and issues an authentication cookie. Requires an antiforgery token. Invalid credentials return 401; exceeding the login rate limit returns 429.",
        "operationId": "FlywheelAuthentication_Login",
        "parameters": [
          {
            "name": "X-Flywheel-CSRF",
            "in": "header",
            "description": "Request token from /flywheel/csrf. Retain the antiforgery cookie as well.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "429": {
            "description": "Too Many Requests"
          },
          "415": {
            "description": "Unsupported Media Type"
          }
        },
        "security": [ ]
      }
    },
    "/flywheel/logout": {
      "post": {
        "tags": [
          "Flywheel authentication"
        ],
        "summary": "Removes the current dashboard authentication cookie.",
        "description": "Removes the dashboard authentication cookie. Requires an authenticated dashboard user and an antiforgery token.",
        "operationId": "FlywheelAuthentication_Logout",
        "parameters": [
          {
            "name": "X-Flywheel-CSRF",
            "in": "header",
            "description": "Request token from /flywheel/csrf. Retain the antiforgery cookie as well.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/schedules/{id}/run": {
      "post": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Queues an immediate execution without changing the recurring schedule.",
        "description": "Requires a recurring schedule and store support for manual execution.",
        "operationId": "FlywheelJobs_RunRecurring",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Flywheel-CSRF",
            "in": "header",
            "description": "Request token from /flywheel/csrf. Retain the antiforgery cookie as well.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedJob"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/history": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns durable activity across all jobs for a requested UTC range.",
        "description": "Defaults to the last day within retention. Start must precede end and remain within retention; end may be at most five minutes in the future.",
        "operationId": "FlywheelJobs_History",
        "parameters": [
          {
            "name": "startAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobHistoryPoint"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/history/search": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns matching retained job counts by current state and update time, independent of pagination.",
        "description": "Query is limited to 200 characters. Supply both UTC range bounds or neither, with start before end. Requires search history support.",
        "operationId": "FlywheelJobs_SearchHistory",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobHistoryPoint"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/history/options": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns the configured aggregate activity retention.",
        "description": "Returns aggregate activity retention in seconds. Requires job history support.",
        "operationId": "FlywheelJobs_HistoryOptions",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HistoryOptions"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/schedules": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns the next 200 recurring schedules and pending executions independently of activity search.",
        "description": "Returns up to 200 recurring schedules and 200 pending executions. Requires schedule query support.",
        "operationId": "FlywheelJobs_Schedules",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleView"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns a page of jobs without payloads or lease tokens.",
        "description": "Offset must be nonnegative. Count must be from 1 to 200 and defaults to 50. Payloads and lease credentials are excluded.",
        "operationId": "FlywheelJobs_List",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/JobView"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/search": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Searches jobs and returns the page and total match count.",
        "description": "Query is limited to 200 characters. Offset must be nonnegative; count must be from 1 to 200. Supply both UTC range bounds or neither. Time filtering requires store support. excludedStates is a comma-separated list of job states.",
        "operationId": "FlywheelJobs_Search",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32",
              "default": 0
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32",
              "default": 50
            }
          },
          {
            "name": "startAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "endAt",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "excludedStates",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/{id}/logs": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns a bounded page of execution logs for an existing job.",
        "description": "Returns retained logs for an existing job. Count must be from 1 to 200 and defaults to 200.",
        "operationId": "FlywheelJobs_GetLogs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "count",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ],
              "format": "int32",
              "default": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/LogEntry"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/{id}": {
      "get": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Returns a job snapshot without its payload or lease token.",
        "description": "Returns a retained job without payload or lease credentials. The identifier must be nonblank and at most 200 characters.",
        "operationId": "FlywheelJobs_Get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/{id}/run": {
      "post": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Queues a fresh standalone execution from a finished job without changing the original execution or schedule.",
        "description": "Requires a succeeded, dead-lettered, or cancelled job. Other states return 409; jobs restricted to an application version return 501. Requires an antiforgery token.",
        "operationId": "FlywheelJobs_RunAgain",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Flywheel-CSRF",
            "in": "header",
            "description": "Request token from /flywheel/csrf. Retain the antiforgery cookie as well.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartedJob"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          },
          "501": {
            "description": "Not Implemented"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/jobs/{id}/cancel": {
      "post": {
        "tags": [
          "Flywheel jobs"
        ],
        "summary": "Requests cancellation of pending or running work.",
        "description": "Requires an antiforgery token. Returns 409 when cancellation cannot be accepted by the store.",
        "operationId": "FlywheelJobs_Cancel",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Flywheel-CSRF",
            "in": "header",
            "description": "Request token from /flywheel/csrf. Retain the antiforgery cookie as well.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "409": {
            "description": "Conflict"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/servers": {
      "get": {
        "tags": [
          "Flywheel servers"
        ],
        "summary": "Returns up to 200 servers with unexpired heartbeats.",
        "description": "Returns at most 200 workers whose heartbeats have not expired, including their public execution snapshots.",
        "operationId": "FlywheelServers_List",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ServerView"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/flywheel/servers/{id}": {
      "get": {
        "tags": [
          "Flywheel servers"
        ],
        "summary": "Returns one live server and the jobs currently leased to it.",
        "description": "Returns a live worker and its leased jobs. The identifier must be nonblank and at most 200 characters.",
        "operationId": "FlywheelServers_Get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerView"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Csrf": {
        "required": [
          "token"
        ],
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Antiforgery token submitted with authenticated dashboard mutations."
          }
        }
      },
      "DashboardUser": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          }
        },
        "description": "The authenticated dashboard identity."
      },
      "HistoryOptions": {
        "required": [
          "retentionSeconds"
        ],
        "type": "object",
        "properties": {
          "retentionSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          }
        }
      },
      "JobHistoryPoint": {
        "required": [
          "timestamp",
          "scheduled",
          "running",
          "succeeded",
          "deadLettered"
        ],
        "type": "object",
        "properties": {
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          },
          "scheduled": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "running": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "succeeded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "deadLettered": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32"
          },
          "cancelled": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32",
            "default": 0
          },
          "waiting": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32",
            "default": 0
          },
          "queued": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int32",
            "default": 0
          },
          "scheduledCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Server-recorded scheduled concurrency for a live bucket, or null when unavailable.",
            "format": "int64",
            "nullable": true
          },
          "runningCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Server-recorded running concurrency for a live bucket, or null when unavailable.",
            "format": "int64",
            "nullable": true
          },
          "queuedCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Server-recorded eligible queue size for a live bucket, or null when unavailable.",
            "format": "int64",
            "nullable": true
          }
        },
        "description": "Job state transitions in a UTC bucket; historical buckets span five minutes and live buckets span one second."
      },
      "JobView": {
        "required": [
          "id",
          "name",
          "state",
          "attempt",
          "updatedAt",
          "cancelRequested",
          "error",
          "version",
          "createdAt",
          "dueAt",
          "leaseUntil",
          "owner"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier of the job or retained entry."
          },
          "name": {
            "type": "string",
            "description": "Stable job name used for registration and persisted work."
          },
          "state": {
            "type": "string",
            "description": "Current durable lifecycle state of the job."
          },
          "attempt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Execution attempt number.",
            "format": "int32"
          },
          "updatedAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Last update time in UTC Unix milliseconds.",
            "format": "int64"
          },
          "cancelRequested": {
            "type": "boolean",
            "description": "Whether cancellation has been requested for this job."
          },
          "error": {
            "type": "string",
            "description": "Retained failure details, or null when no error is recorded.",
            "nullable": true
          },
          "version": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Fencing version of the current execution lease.",
            "format": "int64"
          },
          "createdAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Creation time in UTC Unix milliseconds.",
            "format": "int64"
          },
          "dueAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Next eligible execution time in UTC Unix milliseconds.",
            "format": "int64"
          },
          "leaseUntil": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Lease expiration time in UTC Unix milliseconds.",
            "format": "int64"
          },
          "owner": {
            "type": "string",
            "description": "Node that owns the current lease, if any.",
            "nullable": true
          },
          "parentJobId": {
            "type": "string",
            "description": "Previous step in a saved chain, if any.",
            "nullable": true
          },
          "nextJobId": {
            "type": "string",
            "description": "Next step in a saved chain, if any.",
            "nullable": true
          },
          "maxAttempts": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Maximum execution attempts.",
            "format": "int32",
            "nullable": true
          },
          "timeoutSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Execution timeout per attempt, in seconds.",
            "format": "double",
            "nullable": true
          },
          "priority": {
            "type": "string",
            "description": "Dispatch priority for eligible work.",
            "nullable": true
          },
          "progress": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "enum": [
                  null
                ],
                "nullable": true
              }
            ],
            "description": "Latest progress percentage for the current attempt.",
            "format": "double",
            "nullable": true
          },
          "progressMessage": {
            "type": "string",
            "description": "Optional status text accompanying the latest progress report.",
            "nullable": true
          },
          "progressUpdatedAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Time of the latest progress report in UTC Unix milliseconds.",
            "format": "int64",
            "default": 0
          },
          "description": {
            "type": "string",
            "description": "Optional human-readable description of the job.",
            "nullable": true
          },
          "startedAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Start of the latest attempt in UTC Unix milliseconds, or zero when unavailable.",
            "format": "int64",
            "default": 0
          },
          "completedAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Terminal completion time in UTC Unix milliseconds, or zero when unavailable.",
            "format": "int64",
            "default": 0
          }
        }
      },
      "LogEntry": {
        "required": [
          "id",
          "timestamp",
          "attempt",
          "level",
          "category",
          "message"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Identifier of the retained log entry."
          },
          "timestamp": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Log timestamp in UTC Unix milliseconds.",
            "format": "int64"
          },
          "attempt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "description": "Execution attempt number.",
            "format": "int32"
          },
          "level": {
            "type": "string",
            "description": "Severity name of the captured log message."
          },
          "category": {
            "type": "string",
            "description": "Logger category that emitted the message."
          },
          "message": {
            "type": "string",
            "description": "Message text."
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "nullable": true
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "description": "Credentials submitted to the dashboard sign-in endpoint."
      },
      "RecurringScheduleView": {
        "required": [
          "id",
          "name",
          "interval",
          "dueAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "interval": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          },
          "dueAt": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ],
            "format": "int64"
          },
          "cron": {
            "type": "string",
            "nullable": true
          },
          "timeZoneId": {
            "type": "string",
            "default": "UTC"
          },
          "includeSeconds": {
            "type": "boolean",
            "default": false
          },
          "lastExecutionStatus": {
            "type": "string",
            "nullable": true
          },
          "lastExecutionId": {
            "type": "string",
            "nullable": true
          }
        },
        "description": "A recurring schedule with its interval and next due time in milliseconds."
      },
      "ScheduleView": {
        "required": [
          "recurring",
          "scheduled"
        ],
        "type": "object",
        "properties": {
          "recurring": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RecurringScheduleView"
            }
          },
          "scheduled": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobView"
